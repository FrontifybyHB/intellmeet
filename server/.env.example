# Active keys required by the Phase 0 boot path (config/env.js).
PORT=3000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/intellmeet
NODE_ENV=development

# Future integration keys. Optional until their feature phase is enabled.
# Keep server-only secrets out of client code. Placeholders only.
# JWT_SECRET is required by authenticated routes (e.g. POST /api/meetings/:id/join).
# JWT_SECRET=replace_with_a_secure_random_secret
# Auth is stateless cookie JWTs (no session store, no new secrets):
# short access JWT (10 min, bounded by the absolute login deadline) +
# refresh JWT (absolute login deadline 7 days, never extended).
# Credentials travel EXCLUSIVELY in HttpOnly cookies: im_at (access,
# Path=/) + im_rt (refresh, Path=/api/auth). Authorization headers,
# handshake auth tokens and JSON bodies are never credential paths.
# Readable im_csrf double-submit (x-csrf-token header) is required on
# ALL state changes including login/register (pre-login bootstrap via
# GET /api/auth/csrf); there is no Bearer exemption.
# COOKIE_SAMESITE=lax (default) fits same-site deployments (frontend
# and API share a site; ports may differ). Cross-site deployments must
# set COOKIE_SAMESITE=none, which is production-only (startup fails
# otherwise) and forces Secure; even then, browser third-party-cookie
# blocking may prevent cookie use — CORS does not bypass that.
# No new secrets required.
# LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET are required to mint join tokens.
# LIVEKIT_URL=wss://livekit.example.com
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
# LIVEKIT_TTL_SECONDS=600 (optional, 60-3600)
# JOIN_RATE_LIMIT_MAX=30 (optional join tokens per user+meeting per window, 1-1000)
# JOIN_RATE_LIMIT_WINDOW_MS=60000 (optional rate-limit window, 1000-600000)
# MONGO_MAX_POOL_SIZE=10 (optional, 1-50)
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000 (optional, 500-30000)
# MONGO_SOCKET_TIMEOUT_MS=20000 (optional, 1000-120000)
# Phase 2 chat/socket tuning. All optional; defaults apply when unset.
# CHAT_PAGE_DEFAULT=50 (history messages per page, 1-100)
# CHAT_PAGE_MAX=100 (hard page cap, 1-200)
# CHAT_MAX_CHARS=2000 (message characters, 1-10000)
# CHAT_MAX_BYTES=8000 (message UTF-8 bytes, 100-40000)
# CHAT_SEND_PER_SEC=5 (sustained sends per user across sockets, 1-100)
# CHAT_SEND_BURST=10 (send burst per user, 1-200)
# CHAT_MAX_ROOMS_PER_SOCKET=20 (joined rooms per socket, 1-100)
# CHAT_MAX_SOCKETS=2000 (sockets per process, 1-20000)
# SOCKET_PACKET_MAX_BYTES=16384 (engine packet cap backstop, 1024-1048576)
# Phase 3 recording/lifecycle tuning. All optional; defaults apply when unset.
# RECORDING_PROVIDER=disabled (disabled | mock | live). Default disabled:
# recording control-plane calls fail closed with 503 INTEGRATION_BLOCKER
# until a provider is chosen. "mock" is for tests only. "live" additionally
# requires livekit-server-sdk, LIVEKIT_URL/API_KEY/API_SECRET, and the complete
# private B2 storage group below.
# RECORDING_NOTICE_VERSION=v1 (current recording notice; bumping it
# invalidates prior approvals fail-closed)
# Canonical private Backblaze B2 S3-compatible storage contract:
# B2_ACCESS_KEY_ID= (bucket-scoped B2 application key id)
# B2_SECRET_ACCESS_KEY= (bucket-scoped B2 application key secret)
# B2_BUCKET_NAME= (private bucket)
# B2_REGION= (for example us-west-004; must match the endpoint)
# B2_ENDPOINT=https://s3.<region>.backblazeb2.com
# Legacy RECORDING_* storage names are accepted only as one complete group
# when all B2_* names are absent.
# RECORDING_STORAGE_FORCE_PATH_STYLE=false
# RECORDING_OUTPUT_FORMAT=mp4 (single room-composite file output)
# RECORDING_KEY_PREFIX=recordings/ (private key prefix; SSRF-guarded)
# RECORDING_STORAGE_BASE_URL is not used for B2 playback; signed GetObject
# URLs are generated from the configured private endpoint.
# LIVEKIT_WEBHOOK_SECRET= (defaults to LIVEKIT_API_SECRET for webhook verify)
# RECORDING_PROVIDER_TIMEOUT_MS=8000 (provider RPC bound, 1000-60000)
# RECORDING_MAX_ACTIVE_GLOBAL=10 (global active-Egress budget, 1-100)
# RECORDING_RECOVERY_BATCH=20 (1-200)
# RECORDING_RECOVERY_LEASE_MS=60000 (10000-600000)
# RECORDING_RECOVERY_MAX_ATTEMPTS=5 (1-25)
# RECORDING_ACCESS_LINK_TTL_SECONDS=300 (60-3600)
# WEBHOOK_MAX_BYTES=65536 (4096-1048576)
# REDIS_URL=redis://127.0.0.1:6379 (required for the transcription queue/worker)
# GEMINI_API_KEY=your_server_only_gemini_key (required for TRANSCRIPTION_PROVIDER=live)
# Phase 4 transcription tuning. All optional; defaults apply when unset.
# TRANSCRIPTION_PROVIDER=disabled (disabled | mock | live). Default disabled:
# enqueue/processing fail closed with 503 INTEGRATION_BLOCKER until chosen.
# "mock" is a deterministic labeled twin for tests; "live" requires
# GEMINI_API_KEY + REDIS_URL and uploads audio to the Gemini Files API.
# The transcription worker must also have ffmpeg installed; set FFMPEG_PATH
# to its absolute binary path when it is not available on PATH. Live MP4
# recording audio is decoded to bounded PCM WAV before transcription.
# FFMPEG_PATH=/usr/bin/ffmpeg
# GEMINI_MODEL=gemini-2.0-flash (audio understanding + structured output;
# any change starts a new transcript run version, never mixes results)
# TRANSCRIPT_CHUNK_MS=300000 (per-call audio budget, 30000-900000)
# TRANSCRIPT_OVERLAP_MS=2000 (chunk overlap, 0-15000)
# TRANSCRIPT_MAX_CHUNKS=24 (1-48; longer audio is rejected, not truncated)
# TRANSCRIPT_MAX_AUDIO_BYTES=262144000 (1048576-1073741824)
# TRANSCRIPT_MAX_AUDIO_MS=7200000 (60000-34200000)
# TRANSCRIPT_WORKER_CONCURRENCY=2 (1-16; tune from measured evidence)
# TRANSCRIPT_QUEUE_MAX_WAITING=500 (backlog admission bound, 1-10000)
# TRANSCRIPT_JOB_ATTEMPTS=5 (1-10)
# TRANSCRIPT_STEP_TIMEOUT_MS=120000 (per provider call, 15000-600000)
# TRANSCRIPT_RUN_TIMEOUT_MS=1800000 (total run cap, 120000-7200000)
# TRANSCRIPT_MAX_CALLS_PER_DAY=500 (cluster-wide provider call budget, 1-100000)
# Phase 5 intelligence tuning. All optional; defaults apply when unset.
# INTELLIGENCE_PROVIDER=disabled (disabled | mock | live). Default disabled:
# schedule/processing fail closed with 503 INTEGRATION_BLOCKER until chosen.
# "mock" is a deterministic labeled twin for tests; "live" requires
# GEMINI_API_KEY + REDIS_URL and sends bounded transcript TEXT (segments
# with ids, never audio/credentials) to Gemini generateContent with a
# responseSchema. Transfer consent (aiTransfer at the current notice) is
# re-checked at schedule, before every external call, and before publish.
# GEMINI_MODEL is shared with Phase 4; INTEL_MAX_CALLS_PER_DAY is sized
# JOINTLY with TRANSCRIPT_MAX_CALLS_PER_DAY against the project quota.
# GEMINI_SHARED_MAX_CALLS_PER_DAY=700 (shared project-wide daily Gemini
# call budget across Phase 4 + Phase 5, 1-200000; default = 500 + 200).
# Every provider call in either pipeline takes a shared slot first, so
# the two per-pipeline caps cannot jointly exceed project quota. No
# RPM/TPM/spend guard exists — size against the real Gemini quota.
# INTEL_WORKER_CONCURRENCY=2 (1-16; tune from measured evidence)
# INTEL_QUEUE_MAX_WAITING=200 (backlog admission bound, 1-10000)
# INTEL_JOB_ATTEMPTS=5 (1-10)
# INTEL_STEP_TIMEOUT_MS=120000 (per provider call, 15000-600000)
# INTEL_RUN_TIMEOUT_MS=1800000 (total run cap, 120000-7200000)
# INTEL_MAX_CALLS_PER_DAY=200 (cluster-wide intelligence call budget, 1-100000)
# INTEL_WINDOW_CHARS=12000 (ordered source window size, 2000-60000)
# INTEL_MAX_WINDOWS=8 (1-16; over-budget sources fail, never truncate)
# INTEL_MAX_SOURCE_BYTES=200000 (10000-1000000)
# INTEL_MAX_SOURCE_SEGMENTS=2000 (10-10000)
# Task creation: one Task per approved suggestion via POST
# /api/meetings/:id/action-items/:itemId/task (idempotent on
# taskIdempotencyKey; 201 first, 200 resume; 409 TASK_NOT_APPROVED
# until approved).

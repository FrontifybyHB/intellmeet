# Active keys required by the Phase 0 boot path (config/env.js).
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/intellmeet
NODE_ENV=development

# Future integration keys. Optional until their feature phase is enabled.
# Keep server-only secrets out of client code. Placeholders only.
# JWT_SECRET is required by authenticated routes (e.g. POST /api/meetings/:id/join).
# JWT_SECRET=replace_with_a_secure_random_secret
# LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET are required to mint join tokens.
# LIVEKIT_URL=wss://livekit.example.com
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
# LIVEKIT_TTL_SECONDS=600 (optional, 60-3600)
# JOIN_RATE_LIMIT_MAX=30 (optional join tokens per user+meeting per window, 1-1000)
# JOIN_RATE_LIMIT_WINDOW_MS=60000 (optional rate-limit window, 1000-600000)
# MONGO_MAX_POOL_SIZE=10 (optional, 1-50)
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000 (optional, 500-30000)
# MONGO_SOCKET_TIMEOUT_MS=20000 (optional, 1000-120000)
# Phase 2 chat/socket tuning. All optional; defaults apply when unset.
# CHAT_PAGE_DEFAULT=50 (history messages per page, 1-100)
# CHAT_PAGE_MAX=100 (hard page cap, 1-200)
# CHAT_MAX_CHARS=2000 (message characters, 1-10000)
# CHAT_MAX_BYTES=8000 (message UTF-8 bytes, 100-40000)
# CHAT_SEND_PER_SEC=5 (sustained sends per user across sockets, 1-100)
# CHAT_SEND_BURST=10 (send burst per user, 1-200)
# CHAT_MAX_ROOMS_PER_SOCKET=20 (joined rooms per socket, 1-100)
# CHAT_MAX_SOCKETS=2000 (sockets per process, 1-20000)
# SOCKET_PACKET_MAX_BYTES=16384 (engine packet cap backstop, 1024-1048576)
# REDIS_URL=redis://127.0.0.1:6379
# GEMINI_API_KEY=your_server_only_gemini_key
